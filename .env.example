PORT=3000
MONGO_URI=mongodb://127.0.0.1:27017/xcpc
JWT_SECRET=replace-with-a-random-secret
JWT_EXPIRES_IN=24h

# 密钥统一在“系统设置 → 数据接入与密钥”管理。下方变量仅兼容首次安装，启动时导入系统管理。
CWNUPAA_APP_KEY=
# 允许通过右下角独立入口使用本地密码的用户名，多个用户名用英文逗号分隔。
# 未配置时默认为 admin；设为空值可关闭全部系统账号登录。
SYSTEM_LOGIN_USERNAMES=admin
# VP System 网站设置中创建的历史只读密钥，正常使用请在本系统的密钥管理页面填写。
VP_HISTORY_API_KEY=
